# Скопируйте в .env (файл в .gitignore) и заполните. Все переменные необязательны.

# --- Почта гостю: заказ принят / готов / выдан / снят, со ссылкой на живой статус ---
# Gmail: включите двухэтапную проверку и создайте «пароль приложения».
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=Express Pick-Up <you@gmail.com>
# smtp | outbox (только журнал в панели) | off. Без MAIL_USER/MAIL_PASS — outbox.
# MAIL_TRANSPORT=smtp
# Адрес, который попадает в письма. Без него — http://<IP в локальной сети>:<порт>.
# PUBLIC_URL=https://pickup.example.kz

# --- ИИ-оценка времени приготовления (см. lib/ai.js) ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# XAI_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
